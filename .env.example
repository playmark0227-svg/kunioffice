# server.js（若葉のしずく Stripe Checkout サーバー）用の環境変数
# このファイルを .env にコピーして値を入れてください。.env は Git に含めないこと。

# Stripe シークレットキー（テスト: sk_test_... ／ 本番: sk_live_...）
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Webhook 署名シークレット（Webhook を使う場合のみ）
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ショップの公開URL（決済後の戻り先に使用）
SITE_URL=https://playmark0227-svg.github.io/kunioffice/wakaba

# 決済APIを呼び出してよいサイトのオリジン
ALLOWED_ORIGIN=https://playmark0227-svg.github.io

PORT=3000
